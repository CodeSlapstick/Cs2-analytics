# คัดลอกไฟล์นี้เป็น web/.env แล้วเติมค่าจริง  (คำสั่ง: copy web\.env.example web\.env)
# ไฟล์ .env จริงห้าม commit ขึ้น git เพราะมีความลับอยู่ข้างใน

# กุญแจ Steam Web API — ขอฟรีที่ https://steamcommunity.com/dev/apikey
# ไม่ใส่ก็รันได้ แต่จะไม่ได้ชื่อ/รูปโปรไฟล์จริง (ใช้ "โหมดทดสอบ" แทนได้)
STEAM_API_KEY=

# ที่อยู่ของเว็บเรา ต้องตรงกับที่เปิดในเบราว์เซอร์เป๊ะ ๆ ไม่งั้น Steam จะไม่ส่งกลับมา
BASE_URL=http://localhost:8000

# กุญแจลับไว้เซ็นคุกกี้ — สร้างของตัวเองด้วย: python -c "import secrets; print(secrets.token_hex(32))"
# ถ้าไม่ตั้ง โปรแกรมจะสุ่มใหม่ทุกครั้งที่รัน (ล็อกอินจะหลุดตอนรีสตาร์ตเซิร์ฟเวอร์)
SECRET_KEY=

# เปิด/ปิด "โหมดทดสอบ" (พิมพ์ SteamID64 เข้าเองโดยไม่ต้องล็อกอินจริง)
# 1 = เปิด (สะดวกตอนพัฒนา), 0 = ปิด (ควรปิดตอนใช้งานจริง)
ALLOW_DEV_LOGIN=1
