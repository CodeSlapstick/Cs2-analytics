# ---------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง  ( cp .env.example .env )
# ห้าม commit ไฟล์ .env เข้า git เด็ดขาด
# ไฟล์นี้ (.env.example) ถูก commit — ใส่ได้แค่ค่าตัวอย่าง ห้ามใส่คีย์จริง
#
# ต้องใช้ Node.js 22.13 ขึ้นไป (เช็กด้วย: node -v)
# ---------------------------------------------------------------

PORT=4000
NODE_ENV=development

# URL ของ frontend (ใช้ตอน redirect กลับหลัง login และตั้งค่า CORS)
FRONTEND_URL=http://localhost:5173
# URL ของ backend ตัวเอง (ใช้ประกอบ return_to ของ Steam OpenID)
BACKEND_URL=http://localhost:4000

# ลับสำหรับเซ็น JWT — สุ่มเอง เช่น  openssl rand -hex 32
JWT_SECRET=เปลี่ยนเป็นค่าสุ่มของตัวเอง

# ---------------------------------------------------------------
# ฐานข้อมูล (Sprint 1 ย้ายจาก SQLite มาเป็น PostgreSQL แล้ว)
#
# ไม่ตั้ง DATABASE_URL = ใช้ PGlite (PostgreSQL 18 ฝังในโปรเซส Node)
#   เก็บไฟล์ที่ backend/data/pgdata ไม่ต้องลงอะไรเพิ่ม เหมาะกับตอนพัฒนา/สาธิต
#   ข้อจำกัด: เปิดได้ทีละโปรเซส ต้องปิด backend ก่อนรัน db:migrate / db:seed / etl
#
# ตั้ง DATABASE_URL = ต่อ PostgreSQL server จริง (ใช้ตอน deploy หรือเมื่อจะรัน
#   backend กับ ETL พร้อมกัน) เปิดเซิร์ฟเวอร์ได้ด้วย: docker compose up -d db
# ---------------------------------------------------------------
# DATABASE_URL=postgres://cs2:cs2@localhost:5433/cs2_analytics

# Steam Web API key — ขอฟรีที่ https://steamcommunity.com/dev/apikey
# ใช้แค่ดึงชื่อ/รูปโปรไฟล์มาโชว์ ไม่ใส่ก็ล็อกอินได้ปกติ แค่ชื่อจะขึ้นเป็น Player XXXX
STEAM_API_KEY=

# หมายเหตุ: ระบบนี้ไม่เชื่อมกับ Leetify หรือ API วิเคราะห์เกมภายนอกใด ๆ
# ข้อมูลสถิติทั้งหมดมาจากไฟล์ .dem ที่ parse เอง (parser/parse_demo.py)
# แล้วโหลดเข้าฐานข้อมูลด้วย ETL ของเราเอง (backend/src/etl/)
