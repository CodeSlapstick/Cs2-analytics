{
  "name": "cs2-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "CS2 Team Analytics — เว็บวิเคราะห์สมรรถนะทีม Counter-Strike 2 (SP-404 Senior Project)",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "db:setup": "npm --prefix backend run db:setup",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "etl": "npm --prefix backend run etl --",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build"
  }
}
