# ก๊อปไฟล์นี้เป็น .env แล้วแก้ค่า — .env ไม่เข้า git (ดู .gitignore)
# ถ้าไม่สร้าง .env docker compose จะใช้ค่าดีฟอลต์ที่เขียนไว้ใน docker-compose.yml

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cs2_analytics

# ถ้าเครื่องมี PostgreSQL ลงไว้อยู่แล้ว พอร์ต 5432 จะชนกัน ให้เปลี่ยนเป็น 5433
POSTGRES_PORT=5432

# --- หน้าล็อกอิน Steam (branch Tan-Login, อ่านจาก web/.env) ---
# กุญแจ Steam Web API — ขอฟรีที่ https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
BASE_URL=http://localhost:8000
# สร้างของตัวเองด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 = เปิดโหมดทดสอบ (พิมพ์ SteamID64 เองได้), 0 = ปิด
ALLOW_DEV_LOGIN=1
