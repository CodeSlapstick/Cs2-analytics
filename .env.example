# ก๊อปไฟล์นี้เป็น .env แล้วแก้ค่า — .env ไม่เข้า git (ดู .gitignore)
# ถ้าไม่สร้าง .env docker compose จะใช้ค่าดีฟอลต์ที่เขียนไว้ใน docker-compose.yml (cs2/cs2/cs2)

POSTGRES_USER=cs2
POSTGRES_PASSWORD=cs2
POSTGRES_DB=cs2
POSTGRES_PORT=5432

# สคริปต์ Python อ่านค่านี้ ถ้าไม่ตั้งจะใช้ postgresql://cs2:cs2@localhost:5432/cs2
DATABASE_URL=postgresql://cs2:cs2@localhost:5432/cs2
