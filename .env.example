# ก๊อปไฟล์นี้เป็น .env แล้วแก้ค่า — .env ไม่เข้า git (ดู .gitignore)
# ไฟล์เดียวนี้ถูกอ่านโดยทั้ง docker compose และ backend/ (app.py, load_kills.py)

# --- PostgreSQL (docker compose ใช้สร้าง container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cs2_analytics
# ถ้าเครื่องมี PostgreSQL ลงไว้อยู่แล้ว พอร์ต 5432 จะชนกัน ให้เปลี่ยนเป็น 5433
POSTGRES_PORT=5432

# --- ที่อยู่ DB สำหรับ python ที่รันในเครื่อง (ไม่ใช่ใน container) ---
# พอร์ตต้องตรงกับ POSTGRES_PORT ข้างบน  (service api ใน compose ไม่ใช้ค่านี้ มันคุยกับ db ตรง ๆ)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cs2_analytics

# กุญแจเซ็น JWT ของการล็อกอิน — สร้างของตัวเองด้วย: python -c "import secrets; print(secrets.token_hex(32))"
# ถ้าไม่ตั้ง จะสุ่มใหม่ทุกครั้งที่รัน (ล็อกอินหลุดตอนรีสตาร์ต)
SECRET_KEY=

# --- คิวงาน parse เดโม (Sprint 2) ---
# ที่อยู่ Redis สำหรับ python ที่รันในเครื่อง (service api/worker ใน compose ใช้ redis://redis:6379/0 ของตัวเอง)
REDIS_URL=redis://localhost:6379/0
# rq = ส่งงานให้ worker ผ่าน Redis (ค่าปกติ) | thread = รันในเซิร์ฟเวอร์เองแบบ background thread (ไว้ dev/test โดยไม่มี Redis)
QUEUE_BACKEND=rq

# --- หน้าเว็บ React (service frontend ใน compose) ---
WEB_PORT=3000

# --- ล็อกอิน: Steam อย่างเดียว (JWT ใน httpOnly cookie) — backend/auth.py ---
# 1 = คุกกี้ส่งเฉพาะ HTTPS (เปิดเมื่อ deploy จริง)
COOKIE_SECURE=0

# --- ล็อกอินด้วย Steam (ปุ่มในหน้า /login) ---
# กุญแจ Steam Web API — ขอฟรีที่ https://steamcommunity.com/dev/apikey
# ไม่ใส่ก็ล็อกอินได้ แค่ไม่ได้ชื่อ/รูปโปรไฟล์ (ระบบจะตั้งชื่อผู้ใช้เป็น steam_<SteamID64>)
STEAM_API_KEY=
# ว่าง = ใครมีบัญชี Steam ก็เข้าได้ | ใส่ SteamID64 คั่นด้วยจุลภาคเพื่อจำกัดเฉพาะคนในทีม
# ปล่อยว่างได้ตอน dev แต่ก่อนเปิดให้คนนอกเข้าถึง ควรใส่รายชื่อให้ครบ
STEAM_ALLOWED_IDS=
# ที่อยู่ที่เบราว์เซอร์เห็น (Steam ส่งผู้ใช้กลับมาที่นี่) — ว่าง = เดาจาก Host ของคำขอ ถูกต้องอยู่แล้วเมื่อรันด้วย compose
PUBLIC_URL=

# ==================================================================================
# เช็กลิสต์ก่อนเอาขึ้นเครื่องจริง (dev ในเครื่องไม่ต้องทำก็ได้)
# ==================================================================================
#   1. SECRET_KEY        ต้องตั้ง ไม่งั้นสุ่มใหม่ทุกครั้งที่รีสตาร์ต (ล็อกอินหลุด)
#                        และถ้ารันหลาย worker แต่ละตัวจะได้กุญแจคนละดอก ล็อกอินพังแบบสุ่ม
#   2. COOKIE_SECURE=1   ให้คุกกี้ JWT ส่งเฉพาะ HTTPS
#   3. STEAM_ALLOWED_IDS ว่างไว้ = ใครมี Steam ก็เข้าได้ (ตามที่ออกแบบไว้)

# --- เพดานการอัปโหลดเดโม — backend/app.py ---
MAX_DEMO_MB=600            # เพดานขนาดไฟล์ (เดโมจริงที่เจอใหญ่สุดราว 420 MB)
UPLOAD_MAX_PER_HOUR=20     # กี่ไฟล์ต่อคนต่อชั่วโมง นับจาก matches.uploaded_by
AUTH_MAX_TRIES=20          # กี่ครั้งต่อ IP ที่ยิง /auth/steam/callback ได้ในหนึ่งช่วงเวลา
AUTH_WINDOW_SEC=300        # ความยาวช่วงเวลาของ AUTH_MAX_TRIES (วินาที)
